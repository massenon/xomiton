# =====================================================================================================================
# Xomiton : modèle de configuration (.env.example). Aucun secret ici : les vraies clés vont dans .env (jamais versionné).
#
# Ce fichier est réglé pour la RECETTE LOCALE : base SQLite, e-mails/SMS/push consignés dans storage/logs/laravel.log,
# aucun service externe appelé. `scripts/recette-local.sh` (à la racine du dépôt) le copie en .env et prépare tout.
# Pour la PRODUCTION cPanel : voir le bloc « PRODUCTION » ci-dessous, docs/RUNBOOK.md §1 et docs/DEPLOIEMENT_CPANEL.md ;
# `php artisan xomiton:preflight` valide l'ensemble.
#
# Après toute modification de .env : redémarrer `php artisan serve` (et `queue:work`) ; en production `config:cache`.
# =====================================================================================================================

# ---------------------------------------------------------------------------------------------------------------------
# PRODUCTION (à remplacer dans le .env du serveur uniquement)
#   APP_ENV=production        les comptes de démonstration ne sont JAMAIS semés (seulement local, testing, staging)
#   APP_DEBUG=false
#   APP_URL=https://xomiton.org
#   DB_CONNECTION=mysql       DB_HOST=127.0.0.1 DB_PORT=3306 DB_DATABASE=… DB_USERNAME=… DB_PASSWORD=…  (MySQL 8 / MariaDB 10.6)
#   SANCTUM_STATEFUL_DOMAINS=xomiton.org,www.xomiton.org   (hôte d'APP_URL, sinon le SOS flottant perd le lien avec le compte)
#   MAIL_MAILER=smtp + MAIL_* réels ; HEARTBEAT_URL, BACKUP_ARCHIVE_PASSWORD, SEO_ALLOW_INDEXING=true
#   APP_KEY : `php artisan key:generate` UNE seule fois sur le serveur, jamais versionnée
# ---------------------------------------------------------------------------------------------------------------------

# ---- Application ----------------------------------------------------------------------------------------------------
APP_NAME=Xomiton
# local = recette sur votre poste (comptes de démonstration semés) | production
APP_ENV=local
# Vide : générée par `php artisan key:generate`. Ne jamais la changer sur un site en service (RUNBOOK §8).
APP_KEY=
# Rotation de clé uniquement (RUNBOOK §8) : ancienne APP_KEY pendant `xomiton:reencrypt`.
# APP_PREVIOUS_KEYS=
# true en local (pages d'erreur détaillées), false en production.
APP_DEBUG=true
# URL EXACTE ouverte dans le navigateur (hôte et port compris) : avatars, liens des e-mails et CSP en dépendent.
APP_URL=http://localhost:8000
# Barre de débogage Laravel : désactivée pour garder la console du navigateur propre pendant la recette.
DEBUGBAR_ENABLED=false
DEBUGBAR_COLLECTORS_SYMFONY_REQUEST=false

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Porto-Novo
# Fuseau des heures affichées au public (page de maintenance, annonces) ; la base reste en UTC (config/app.php).
XOMITON_DISPLAY_TIMEZONE=Africa/Porto-Novo

# Référencement : false interdit toute exploration dans /robots.txt ; hors production tout est déjà interdit.
SEO_ALLOW_INDEXING=false

# Bibliothèque hors ligne : badges « Hors ligne » des ressources, mises en cache par le service worker (build seulement).
XOMITON_OFFLINE_LIBRARY=true
# Version du service worker : l'incrémenter force le renouvellement du cache hors ligne chez les visiteur·ses.
# XOMITON_SW_VERSION=1

# ---- Mode maintenance (RG-14) -----------------------------------------------------------------------------------------
# Pilote du mode maintenance applicatif. S'active dans Administration › Maintenance ou par
# `php artisan xomiton:maintenance on --minutes=30 --message="…" --reason="…"` (off / status). Admin et superadmin se
# connectent toujours ; SOS, signalement, suivi, urgences et connexion restent servis. Ne jamais utiliser `artisan down`.
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ---- Journaux : en mode « log », e-mails, SMS, push et codes OTP sont lus dans storage/logs/laravel.log ---------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Base de données ------------------------------------------------------------------------------------------------
# Recette locale : SQLite, fichier dédié (ignoré par git). Chemin relatif à web/ ; `scripts/recette-local.sh` le crée.
# N'utilisez pas database/database.sqlite : `migrate:fresh` l'efface.
DB_CONNECTION=sqlite
DB_DATABASE=database/recette.sqlite
# Production (MySQL 8 / MariaDB 10.6) : DB_CONNECTION=mysql puis décommenter et renseigner.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=xomiton
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# ---- Sessions, file, cache (hébergement mutualisé D7 : pas de Redis, pas de processus permanent) --------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Contenu des sessions chiffré ; sessions d'invité·e sans IP ni user agent.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Sanctum en mode SPA : domaines (hôte[:port]) dont le cookie de session authentifie /api/v1 (espace Vue, SOS flottant).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
# Cookie Secure : vrai par défaut quand APP_ENV=production ; ne forcer false qu'en l'absence de TLS.
# SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
# File en base : `php artisan queue:work --stop-when-empty` (exports de données, e-mails en file, etc.).
QUEUE_CONNECTION=database
CACHE_STORE=file
# CACHE_PREFIX=

# ---- E-mails ---------------------------------------------------------------------------------------------------------
# failover = tente le SMTP puis, s'il est injoignable, consigne l'e-mail dans storage/logs/laravel.log (recette locale).
# log = consigne seulement ; smtp = envoi réel (production). Le SMTP est aussi réglable dans Administration › Paramètres.
# Pour vider la boîte d'envoi (confirmation newsletter, test de campagne, export de données) : `php artisan mail:flush-outbox`.
MAIL_MAILER=failover
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bonjour@xomiton.org"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Newsletter ------------------------------------------------------------------------------------------------------
# Clé HMAC des liens de suivi (pixel, clic) ; `php -r "echo bin2hex(random_bytes(32));"`. Vide = dérivée d'APP_KEY ;
# la changer invalide les liens des campagnes déjà envoyées.
XOMITON_NEWSLETTER_KEY=
# Durée plancher (ms) de l'inscription publique : même délai pour une adresse connue ou inconnue (anti-énumération).
XOMITON_NEWSLETTER_FLOOR_MS=600

# ---- SOS et alertes (valeurs par défaut sûres ; changez-les seulement si la coordination le décide) --------------------
# Les durées du bouton SOS (maintien 2 s, décompte annulable 5 s, attente GPS 8 s au total) sont fixées dans
# config/xomiton.php (décision Q61), pas dans .env.
# Minutes sans accusé de réception avant escalade d'un SOS vers le point focal (RG-05).
XOMITON_ESCALATION_MINUTES=5
# Délai maximal (s) accordé à chaque fournisseur d'envoi pendant un SOS.
XOMITON_PROVIDER_TIMEOUT=3
# Nombre maximal de tentatives de renvoi d'une notification de SOS.
XOMITON_SOS_MAX_RETRIES=10

# ---- Notifications push (désactivées : pilote « log », rien ne part vraiment) ------------------------------------------
# Navigateur (Web Push VAPID) : WEBPUSH_DRIVER=vapid après `composer require minishlink/web-push` et clés VAPID.
# Générer la paire de clés : `npx web-push generate-vapid-keys`.
WEBPUSH_DRIVER=log
VAPID_SUBJECT=mailto:bonjour@xomiton.org
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Application Flutter (Firebase Cloud Messaging, API HTTP v1) : FCM_DRIVER=fcm + compte de service Firebase.
# Aucun paquet Composer requis. Essai : php artisan notifications:test-push <jeton FCM> --urgent --yes
FCM_DRIVER=log
# Chemin ABSOLU du JSON du compte de service (hors public/, chmod 600), ex. /home/COMPTE/secrets/firebase-sa.json
FIREBASE_CREDENTIALS=
# Facultatif : lu dans le JSON s'il est absent.
FIREBASE_PROJECT_ID=

# ---- SMS de secours du SOS (désactivés : pilote « log ») ----------------------------------------------------------------
# SMS_DRIVER = log (défaut) | vonage | twilio. Numéros au format E.164 (+229 par défaut). SMS_PROVIDER = ancien nom.
# Essai : php artisan notifications:test-sms +229XXXXXXXX --yes (facturé par le fournisseur).
SMS_DRIVER=log
# Expéditeur : nom alphanumérique (11 caractères max) ou numéro E.164 ; à confirmer avec le devis béninois.
SMS_SENDER=Xomiton
# Vonage (SMS_DRIVER=vonage)
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Twilio (SMS_DRIVER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Facultatif : prioritaire sur SMS_SENDER pour Twilio.
TWILIO_MESSAGING_SERVICE_SID=

# ---- Assistant (base de connaissances par défaut ; le LLM Gemini est DÉSACTIVÉ) ----------------------------------------
# kb = base de connaissances (défaut) | gemini (repli seulement si ASSISTANT_LLM_ENABLED=true ET GEMINI_API_KEY renseignée).
# NE PAS ACTIVER en production avant l'avis juridique (données de santé et de violences vers un tiers hors UE, DPA
# Google, région) : docs/DECISIONS_A_VALIDER.md. Les messages de crise et de SOS ne sont jamais envoyés au LLM.
# Coupure d'urgence : ASSISTANT_LLM_ENABLED=false. Essai : php artisan assistant:test-llm --yes
ASSISTANT_PROVIDER=kb
ASSISTANT_LLM_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=4
GEMINI_PER_HOUR=10

# ---- Passerelles réseaux sociaux (comptes de l'organisation uniquement ; sans clés : « publication manuelle ») ----------
# XOMITON_GATEWAYS_DRIVER=log
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TELEGRAM_BOT_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Supervision et sauvegardes ----------------------------------------------------------------------------------------
# Signal de vie du cron vers la supervision externe (Healthchecks.io / UptimeRobot). Vide en recette locale.
HEARTBEAT_URL=
# Signal conditionné au succès d'alerts:escalate et notifications:retry ; false pour le désactiver.
HEARTBEAT_REQUIRE_MARKERS=true
# Sauvegardes : disque Laravel (stockage externe chiffré en production) et mot de passe des archives ZIP.
# Vide en local : un avertissement normal s'affiche dans Administration › Sauvegardes.
BACKUP_DISK=local
BACKUP_ARCHIVE_PASSWORD=

# ---- Front (Vite) ------------------------------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ---- Mentions légales et responsable des données (pages publiques ; vide = marqueur « À COMPLÉTER PAR LE CLIENT ») -------
XOMITON_LEGAL_PUBLISHER_NAME=
XOMITON_LEGAL_FORM=
XOMITON_LEGAL_REGISTRATION=
XOMITON_LEGAL_ADDRESS=
XOMITON_LEGAL_DIRECTOR=
XOMITON_LEGAL_PHONE=
XOMITON_LEGAL_HOST_NAME=
XOMITON_LEGAL_HOST_ADDRESS=
XOMITON_LEGAL_HOST_COUNTRY=
XOMITON_LEGAL_DPO_NAME=
XOMITON_LEGAL_DPO_EMAIL=
XOMITON_LEGAL_JURISDICTION=
