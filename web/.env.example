APP_NAME=Xomiton
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Debugbar (local) : le collecteur « request » insère des scripts Sfdump sans nonce via jQuery.globalEval et
# déclenche des violations CSP dans la console (P2-13) ; le reste du Debugbar reçoit le nonce (SecurityHeaders).
DEBUGBAR_COLLECTORS_SYMFONY_REQUEST=false
APP_URL=http://localhost:8000
# Référencement : false interdit toute exploration dans /robots.txt (recette publique) ; hors production, tout est déjà interdit.
SEO_ALLOW_INDEXING=true
# Interrupteurs et badges « Hors ligne » des ressources (P4-03) : false tant que le service worker (P5-10) n'est pas livré.
XOMITON_OFFLINE_LIBRARY=false

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Porto-Novo

# Maintenance (RG-14) : seuls admin et superadmin se connectent quand elle est active.
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production cPanel : MySQL 8 / MariaDB 10.6 (DATABASE_ENGINEERING.md). Local : sqlite possible.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xomiton
DB_USERNAME=xomiton
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Hébergement mutualisé (D7, ADR-11) : aucun processus permanent, pas de Redis.
# Le jour où un VPS est disponible : redis + workers + reverb sans changer le code.
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Contenu des sessions chiffré (P5-04 : récit flashé après une erreur) ; sessions d'invité·e sans IP ni user agent.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Sanctum en mode SPA (ADR-31) : domaines (hôte[:port]) dont le cookie de session authentifie /api/v1 (espace Vue).
# En production, y mettre l'hôte d'APP_URL (ex. xomiton.org,www.xomiton.org) : sinon le bouton SOS flottant (P5-08)
# envoie un SOS sans lien avec le compte (contacts de confiance non prévenus, pas de suivi).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
# Cookie Secure : true par défaut quand APP_ENV=production (config/session.php) ; ne forcer false qu'en l'absence de TLS.
# SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file
# CACHE_PREFIX=

# E-mails : le SMTP est aussi réglable dans Administration › Templates e-mails (table settings) ;
# sans hôte, les e-mails sont consignés dans la boîte d'envoi locale (mail_logs, transport "outbox").
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bonjour@xomiton.org"
MAIL_FROM_NAME="${APP_NAME}"

# Notifications push (ADR-25, P3-02) : pilotes `log` tant que les paquets ne sont pas installés.
# Web Push navigateur : WEBPUSH_DRIVER=vapid après `composer require minishlink/web-push` (clés VAPID ci-dessous).
# Flutter : FCM HTTP v1 authentifié par un compte de service Firebase (fichier JSON HORS racine web), jamais par une
# clé serveur héritée ; FCM_DRIVER=firebase après installation du paquet FCM.
WEBPUSH_DRIVER=log
VAPID_SUBJECT=mailto:bonjour@xomiton.org
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
FCM_DRIVER=log
FIREBASE_CREDENTIALS=

# SMS de secours pour le SOS (fournisseur configurable, NOTIFICATIONS_INSTRUCTION.md §1)
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER=Xomiton

# Signal de vie du cron vers la supervision externe (D7) : URL Healthchecks.io / UptimeRobot
HEARTBEAT_URL=

# Sauvegardes : stockage externe chiffré (disque Laravel) et mot de passe des archives
BACKUP_DISK=local
BACKUP_ARCHIVE_PASSWORD=

# Passerelles réseaux sociaux (D4-bis) : comptes de l'organisation uniquement
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TELEGRAM_BOT_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Assistant (LLM) : fournisseur et clé, garde-fous dans config/xomiton.php
ASSISTANT_PROVIDER=null
ASSISTANT_API_KEY=

VITE_APP_NAME="${APP_NAME}"
