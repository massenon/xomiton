# =====================================================================================================================
# Xomiton : modèle de configuration de PRODUCTION (.env.production.example), pour l'hébergement cPanel.
#
# AUCUN secret réel et aucune valeur inventée ici : tout ce qui est vide est à fournir (compte d'hébergement, base,
# SMTP, SMS, Firebase, informations légales du client). Ce fichier est versionné ; le vrai `.env` ne l'est JAMAIS.
#
# PROCÉDURE (depuis /home/COMPTE/xomiton/web ; PHP=/opt/cpanel/ea-php83/root/usr/bin/php) :
#   1. cp .env.production.example .env  puis  chmod 600 .env   (ne jamais l'envoyer par e-mail ni le mettre sur Git)
#   2. Renseigner les valeurs vides marquées « À RENSEIGNER » (base MySQL, SMTP, domaine) ; adapter APP_URL.
#   3. $PHP artisan key:generate --force      UNE SEULE FOIS, sur un site neuf (jamais sur un site en service)
#   4. scripts/deploy.sh --first              migrations, storage:link, caches, contrôle xomiton:preflight
#   5. $PHP artisan xomiton:install           premier déploiement : données de base, diagnostic, premier super-admin
#   6. $PHP artisan config:cache              à refaire après CHAQUE modification de .env (puis route:cache, view:cache,
#                                             event:cache) ; sans cela, le changement n'est pas pris en compte
#   7. $PHP artisan xomiton:preflight         doit se terminer sans erreur avant d'ouvrir le site au public
#   Cron (chaque minute) : * * * * * $PHP /home/COMPTE/xomiton/web/artisan schedule:run >> /dev/null 2>&1
#   Détails : docs/GUIDE_DEPLOIEMENT.md (§6 à §16), docs/DEPLOIEMENT_CPANEL.md, docs/RUNBOOK.md.
#
# Règles du format .env : une variable par ligne ; commentaires sur une ligne à part (pas en fin de ligne) ; valeurs
# contenant des espaces, des virgules ou un « # » entre guillemets doubles.
# =====================================================================================================================

# ---- Application ----------------------------------------------------------------------------------------------------
APP_NAME=Xomiton
# production : les comptes de démonstration ne sont JAMAIS semés.
APP_ENV=production
# Vide : générée par `php artisan key:generate --force` (étape 3). Ne jamais la changer sur un site en service
# (données chiffrées illisibles) ; sauvegarder cette clé ailleurs que sur le serveur.
APP_KEY=
# Rotation de clé uniquement (RUNBOOK §8) : ancienne APP_KEY pendant `xomiton:reencrypt`. Laisser vide sinon.
APP_PREVIOUS_KEYS=
# OBLIGATOIREMENT false : en mode débogage, une erreur afficherait des secrets.
APP_DEBUG=false
# Adresse publique EXACTE, en https, sans « / » final. À ADAPTER si le domaine retenu diffère (à confirmer avec le client).
# Avatars, liens des e-mails, CSP et pages légales en dépendent ; le dossier Google Play doit citer le même domaine.
APP_URL=https://xomiton.org
# Barre de débogage Laravel : toujours désactivée en production.
DEBUGBAR_ENABLED=false
DEBUGBAR_COLLECTORS_SYMFONY_REQUEST=false

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Porto-Novo
# Fuseau des heures affichées au public (page de maintenance, annonces) ; la base reste en UTC.
XOMITON_DISPLAY_TIMEZONE=Africa/Porto-Novo

# Référencement : true autorise l'exploration (/robots.txt). Mettre false tant que le site n'est pas ouvert au public
# (pages légales à compléter) ; hors production, tout est déjà interdit.
SEO_ALLOW_INDEXING=true

# Bibliothèque hors ligne : badges « Hors ligne » et mise en cache par le service worker.
XOMITON_OFFLINE_LIBRARY=true
# Version du service worker : l'incrémenter force le renouvellement du cache hors ligne chez les visiteur·ses.
XOMITON_SW_VERSION=1
# Chemin du script du service worker issu du build (ne changer qu'avec le build front).
XOMITON_SW_SCRIPT=build/sw.js

BCRYPT_ROUNDS=12

# ---- Mode maintenance (RG-14) -----------------------------------------------------------------------------------------
# Pilote du mode maintenance applicatif : `php artisan xomiton:maintenance on --minutes=30 --message="…" --reason="…"`
# (off / status) ou Administration › Maintenance. SOS, signalement, suivi, urgences et connexion restent servis.
# Ne jamais utiliser `artisan down`.
APP_MAINTENANCE_DRIVER=file
# Banque utilisée seulement si APP_MAINTENANCE_DRIVER=cache (inutile avec « file »).
# APP_MAINTENANCE_STORE=database

# ---- Journaux (storage/logs/laravel.log) -------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
# warning en production ; debug seulement pour une enquête ponctuelle (les journaux ne doivent jamais contenir de
# contenu de messages ni de position de SOS).
LOG_LEVEL=warning
# Conservation (jours) du canal « daily », si LOG_STACK=daily.
# LOG_DAILY_DAYS=14

# ---- Base de données MySQL 8 / MariaDB 10.6 ---------------------------------------------------------------------------
# À RENSEIGNER avec la base et l'utilisateur créés dans cPanel › Bases de données MySQL (mot de passe long et unique).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# Socket Unix, si l'hébergeur l'impose à la place de DB_HOST/DB_PORT.
# DB_SOCKET=
# Variables de la file d'attente et du cache en base (valeurs par défaut sûres, inutile de les définir).
# DB_QUEUE_CONNECTION=
# DB_QUEUE_TABLE=jobs
# DB_QUEUE=default
# DB_QUEUE_RETRY_AFTER=90
# QUEUE_FAILED_DRIVER=database-uuids

# ---- Sessions, file, cache (hébergement mutualisé : ni Redis ni processus permanent) ----------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Contenu des sessions chiffré ; sessions d'invité·e sans IP ni user agent.
SESSION_ENCRYPT=true
SESSION_PATH=/
# Nom du cookie de session ; par défaut dérivé d'APP_NAME. Ne le changer que sur un site neuf.
# SESSION_COOKIE=
SESSION_DOMAIN=null
# Cookie envoyé uniquement en HTTPS (HTTPS obligatoire sur tout le domaine).
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Sanctum (SPA) : hôtes (hôte[:port]) dont le cookie de session authentifie /api/v1 (espace Vue, SOS flottant).
# ADAPTER à l'hôte d'APP_URL, avec et sans « www ».
SANCTUM_STATEFUL_DOMAINS=xomiton.org,www.xomiton.org
# Préfixe des jetons d'API (analyse de fuites de secrets) ; vide par défaut.
# SANCTUM_TOKEN_PREFIX=

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
# File en base, traitée par le cron (`queue:work --stop-when-empty` planifié) : exports de données, e-mails en file.
QUEUE_CONNECTION=database
# Cache fichier (storage/framework/cache) : suffisant sur cPanel.
CACHE_STORE=file
# CACHE_PREFIX=

# ---- E-mails : SMTP réel -----------------------------------------------------------------------------------------------
# smtp = envoi réel. Le SMTP est aussi réglable dans Administration › Paramètres. À RENSEIGNER avec les accès de la
# boîte d'envoi (cPanel › Comptes de messagerie, ou fournisseur transactionnel).
MAIL_MAILER=smtp
MAIL_HOST=
# 587 (STARTTLS) ; 465 avec MAIL_SCHEME=smtps ; suivre l'indication du fournisseur.
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=
MAIL_PASSWORD=
# Adresse d'expédition : boîte existante, sur le domaine du site (SPF, DKIM, DMARC à configurer). À confirmer.
MAIL_FROM_ADDRESS="bonjour@xomiton.org"
MAIL_FROM_NAME="${APP_NAME}"
# Nom de domaine annoncé au serveur SMTP (EHLO) ; par défaut, l'hôte d'APP_URL.
# MAIL_EHLO_DOMAIN=
# Chemin de sendmail, si MAIL_MAILER=sendmail (non utilisé ici).
# MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs -i

# ---- Newsletter --------------------------------------------------------------------------------------------------------
# Clé HMAC des liens de suivi (pixel, clic) : 64 caractères hexadécimaux, générés par
# php -r "echo bin2hex(random_bytes(32));"   Vide = dérivée d'APP_KEY. La changer invalide les liens déjà envoyés.
XOMITON_NEWSLETTER_KEY=
# E-mails envoyés par lot de campagne.
XOMITON_NEWSLETTER_BATCH=200
# Durée plancher (ms) de l'inscription publique : même délai pour une adresse connue ou inconnue (anti-énumération).
XOMITON_NEWSLETTER_FLOOR_MS=600
# Domaines d'e-mail jetables à signaler EN PLUS de la liste intégrée (séparés par des virgules).
XOMITON_DISPOSABLE_DOMAINS=

# ---- SOS et alertes (valeurs par défaut sûres ; ne les changer que sur décision de la coordination) --------------------
# Minutes sans accusé de réception avant escalade d'un SOS vers le point focal (RG-05).
XOMITON_ESCALATION_MINUTES=5
# Délai maximal (secondes) accordé à chaque fournisseur d'envoi pendant un SOS.
XOMITON_PROVIDER_TIMEOUT=3
# Nombre maximal de tentatives de renvoi d'une notification de SOS.
XOMITON_SOS_MAX_RETRIES=10
# Budget total (secondes) de l'envoi d'un SOS.
XOMITON_DISPATCH_BUDGET=8
# Délai de grâce (minutes) après escalade avant clôture automatique de l'alerte.
XOMITON_ESCALATION_GRACE_MINUTES=1440
# Pair·es prévenu·es à l'envoi d'un SOS : zone (défaut) ou all.
XOMITON_PEER_RECIPIENTS=zone
# Signalements : rappel puis escalade (minutes) quand personne ne les prend en charge.
XOMITON_REPORT_REMIND_MINUTES=1440
XOMITON_REPORT_ESCALATE_MINUTES=2880
# Contenus masqués automatiquement après ce nombre de signalements.
XOMITON_AUTO_HIDE_REPORTS=3
# Durée (heures) de mémorisation des clés d'idempotence des requêtes API.
XOMITON_IDEMPOTENCY_TTL_HOURS=48

# ---- Notifications push ------------------------------------------------------------------------------------------------
# Navigateur (Web Push VAPID) : log tant que le paquet minishlink/web-push (non livré) et les clés VAPID manquent.
# Générer la paire de clés : `npx web-push generate-vapid-keys`.
WEBPUSH_DRIVER=log
# Contact VAPID : mailto: suivi d'une adresse lue par l'équipe.
VAPID_SUBJECT=mailto:bonjour@xomiton.org
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Application Flutter (Firebase Cloud Messaging, API HTTP v1) : log tant que le projet Firebase n'est pas prêt, puis fcm.
# Essai : php artisan notifications:test-push <jeton FCM> --urgent --yes
FCM_DRIVER=log
# Chemin ABSOLU du JSON du compte de service Firebase, HORS de public/ et en chmod 600
# (forme : /home/COMPTE/secrets/firebase-sa.json). Ne jamais versionner ce fichier.
FIREBASE_CREDENTIALS=
# Facultatif : lu dans le JSON s'il est absent.
FIREBASE_PROJECT_ID=

# ---- SMS de secours du SOS ---------------------------------------------------------------------------------------------
# SMS_DRIVER = log (rien ne part) | vonage | twilio. Passer à vonage ou twilio quand le compte existe et que les clés
# ci-dessous sont renseignées. Numéros au format E.164 (+229 par défaut). SMS_PROVIDER = ancien nom (ne pas l'utiliser).
# Essai (facturé par le fournisseur) : php artisan notifications:test-sms +229XXXXXXXX --yes
SMS_DRIVER=log
# Expéditeur : nom alphanumérique (11 caractères maximum) ou numéro E.164 ; à confirmer avec le fournisseur.
SMS_SENDER=Xomiton
# Vonage (SMS_DRIVER=vonage)
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Twilio (SMS_DRIVER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Facultatif : prioritaire sur SMS_SENDER pour Twilio.
TWILIO_MESSAGING_SERVICE_SID=

# ---- Assistant : base de connaissances ; le LLM Gemini est DÉSACTIVÉ ---------------------------------------------------
# NE PAS ACTIVER avant l'avis juridique (données de santé et de violences vers un tiers hors UE, DPA Google, région) :
# docs/DECISIONS_A_VALIDER.md. Les messages de crise et de SOS ne sont jamais envoyés au LLM.
# Coupure d'urgence : ASSISTANT_LLM_ENABLED=false.
ASSISTANT_PROVIDER=kb
ASSISTANT_LLM_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=4
GEMINI_PER_HOUR=10

# ---- Passerelles réseaux sociaux (comptes de l'organisation ; sans clés : « publication manuelle ») -------------------
XOMITON_GATEWAYS_DRIVER=log
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TELEGRAM_BOT_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Supervision (heartbeat) -------------------------------------------------------------------------------------------
# URL de vérification Healthchecks.io / UptimeRobot, appelée chaque minute par le cron. À RENSEIGNER après création de la
# vérification (GUIDE_DEPLOIEMENT §13.1) ; vide = pas de supervision (à éviter en production).
HEARTBEAT_URL=
# Signal envoyé seulement si alerts:escalate et notifications:retry ont réussi ; false pour le désactiver.
HEARTBEAT_REQUIRE_MARKERS=true

# ---- Sauvegardes -------------------------------------------------------------------------------------------------------
# Disque Laravel des sauvegardes : un disque externe chiffré est recommandé (décision Q9) ; local = même serveur.
BACKUP_DISK=local
# Mot de passe des archives ZIP : long, unique, conservé AILLEURS que sur le serveur (sans lui, restauration impossible).
BACKUP_ARCHIVE_PASSWORD=
# Sauvegarde de la base avec mysqldump ; repli en archive JSON si proc_open/exec sont désactivés.
XOMITON_MYSQLDUMP=true
XOMITON_MYSQLDUMP_BINARY=mysqldump

# ---- Rétention, exports et rapports ------------------------------------------------------------------------------------
# Durée de conservation (jours) du journal d'audit. Les autres durées (e-mails 180 jours, codes 24 h, dossiers 5 ans,
# appareils inactifs 180 jours) sont fixées dans config/xomiton.php.
XOMITON_AUDIT_RETENTION_DAYS=90
# Disque des rapports et exports générés.
XOMITON_REPORTS_DISK=local
# Nombre maximal de lignes d'un export de données (tableurs) et d'un export PDF.
XOMITON_EXPORT_MAX_ROWS=20000
XOMITON_PDF_MAX_ROWS=200

# ---- Performance : cache des pages publiques et navigation anticipée ---------------------------------------------------
# Cache HTTP des pages publiques sans session : Cache-Control public, max-age puis stale-while-revalidate (secondes).
# Une publication apparaît au plus après max-age + swr dans un navigateur qui a déjà la page (docs/PERFORMANCE.md §11).
XOMITON_HTTP_CACHE_MAX_AGE=60
XOMITON_HTTP_CACHE_SWR=300
# Durée (minutes) du cache de données de la page d'accueil (thématiques, FAQ), vidé à chaque modification.
XOMITON_HOME_CACHE_MINUTES=60
# Navigation sans rechargement perceptible (règles de spéculation) sur une liste blanche de pages publiques en lecture seule.
XOMITON_SPECULATION=true

# ---- Front (Vite) ------------------------------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# =====================================================================================================================
# Informations légales (à compléter par le client avant la mise en ligne)
# =====================================================================================================================
# Le client ne les a pas encore fournies : AUCUNE valeur n'est inventée ici. Elles alimentent les pages publiques
# /mentions-legales, /politique-de-confidentialite et /conditions-utilisation. LAISSER VIDE tant que l'information
# manque : la page affiche alors le repère « [À COMPLÉTER PAR LE CLIENT : …] ». N'écrivez jamais de texte provisoire
# (« A_COMPLETER », « XXX ») : il serait publié tel quel. Après modification : `php artisan config:cache`.
# Les exemples entre parenthèses ne montrent que le FORMAT attendu.

# Éditeur du site (pages : mentions légales, confidentialité, conditions)
# (format : raison sociale ou dénomination officielle)
XOMITON_LEGAL_PUBLISHER_NAME=
# (format : association, ONG, SARL, … tel que dans les statuts)
XOMITON_LEGAL_FORM=
# (format : numéro tel qu'il figure sur le récépissé ou le registre officiel)
XOMITON_LEGAL_REGISTRATION=
# (format : numéro, rue, quartier, ville, pays)
XOMITON_LEGAL_ADDRESS=
# (format : prénom NOM)
XOMITON_LEGAL_DIRECTOR=
# (format international : +229 suivi du numéro)
XOMITON_LEGAL_PHONE=

# Hébergeur (pages : mentions légales, confidentialité)
# (format : raison sociale de l'hébergeur cPanel retenu)
XOMITON_LEGAL_HOST_NAME=
# (format : numéro, rue, code postal, ville)
XOMITON_LEGAL_HOST_ADDRESS=
# (format : nom du pays où sont hébergées les données)
XOMITON_LEGAL_HOST_COUNTRY=

# Protection des données (pages : mentions légales, confidentialité)
# (format : prénom NOM, ou fonction)
XOMITON_LEGAL_DPO_NAME=
# Boîte réellement lue, pour exercer ses droits d'accès et d'effacement. (format : prenom.nom@votre-domaine)
XOMITON_LEGAL_DPO_EMAIL=

# Droit applicable (conditions d'utilisation, mentions légales)
# (format : « tribunaux de <ville>, <pays> », à confirmer par le conseil juridique)
XOMITON_LEGAL_JURISDICTION=

# E-mail de contact public : il n'existe PAS de variable .env. Il se règle dans Administration › Paramètres › Général
# (champ « contact_email » ; valeur d'origine contact@xomiton.bj, à remplacer par la vraie boîte). S'il est vide,
# l'application se rabat sur MAIL_FROM_ADDRESS.
